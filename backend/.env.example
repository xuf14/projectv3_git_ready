# ===== Cấu hình Backend =====
PORT=3000
# BẮT BUỘC, tối thiểu 16 ký tự — thiếu hoặc quá ngắn thì backend dừng ngay khi khởi động.
# Không dùng lại chuỗi mẫu này; sinh chuỗi ngẫu nhiên riêng cho mỗi môi trường.
JWT_SECRET=doi-thanh-chuoi-bi-mat-cua-ban

# Các origin được phép gọi API (ngăn cách bằng dấu phẩy).
# Bỏ trống = dùng mặc định cổng dev của Vite (5173/4173).
CORS_ORIGINS=http://localhost:5173

# Giới hạn tần suất theo IP trong 1 phút cho route công khai
THROTTLE_LOGIN_LIMIT=10
THROTTLE_DANG_KY_LIMIT=5

# ===== Kết nối PostgreSQL =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=bv_phusan

# Tự động tạo/cập nhật bảng theo entity. ĐỂ false — schema đi qua migration:
#   npm run migration:generate -- src/migrations/TenThayDoi   (sinh từ thay đổi entity)
#   npm run migration:run                                     (áp dụng)
#   npm run migration:revert                                  (hoàn tác bước cuối)
# Chỉ đặt true khi dựng database trống hoặc chạy kiểm thử.
DB_SYNC=false
# Ghi log câu lệnh SQL (true để debug)
DB_LOGGING=false

# ===== Kiểm thử tự động (npm test) =====
# Test tự tạo và chỉ làm việc trên database riêng này — không bao giờ đụng DB phát triển
TEST_DB_NAME=bv_phusan_test

# ===== Trợ lý ảo (chatbot) =====
# local  = model chạy trên máy qua LM Studio/Ollama/llama.cpp (miễn phí, offline)
# claude = gọi Claude API (cần ANTHROPIC_API_KEY, tốn phí theo lượt gọi)
CHAT_PROVIDER=local

# --- Khi CHAT_PROVIDER=local ---
# LM Studio mặc định http://localhost:1234/v1 · Ollama http://localhost:11434/v1
LOCAL_AI_BASE_URL=http://localhost:1234/v1
LOCAL_AI_MODEL=qwen/qwen3.5-9b
# Máy chủ chạy trên máy không cần khóa thật, để trống cũng được
LOCAL_AI_KEY=

# --- Khi CHAT_PROVIDER=claude ---
ANTHROPIC_API_KEY=
